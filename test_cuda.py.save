import torch

print("Torch version:")
print(torch.__version__)

print("CUDA available:")
print(torch.cuda.is_available())

if torch.cuda.is_available():
    print("GPU:")
    print(torch.cuda.get_device_name(0))

    print("VRAM:")
    print(
        torch.cuda.get_device_properties(0).total_memory / 1024**3,
        "GB"
    )

