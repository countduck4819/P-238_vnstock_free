# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
MODEL_NAME=gpt-4o-mini
# Optional OpenAI-compatible endpoint (for example a Qwen provider)
# LLM_BASE_URL=https://provider.example/v1
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Local port of the SSH tunnel forwarding to the VPS PostgreSQL service.
VPS_DB_LOCAL_PORT=5434

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Qdrant Cloud (required for production; never commit the API key)
QDRANT_URL=https://your-cluster.aws.cloud.qdrant.io
QDRANT_API_KEY=
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=your-ai-log-api-key
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
# News fetch concurrency / timeout
NEWS_MAX_UPSTREAM_REQUESTS=4
NEWS_REQUEST_DELAY_SECONDS=0.5
NEWS_REQUEST_TIMEOUT_SECONDS=20
NEWS_SLOT_TIMEOUT_SECONDS=2
NEWS_FILING_CACHE_TTL_HOURS=24
FINANCE_REQUEST_DELAY_SECONDS=0.5

# ---- FinSight bounded research agent ----
FINSIGHT_ENABLE_LLM=false
FINSIGHT_ENABLE_WEB=false
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# Optional comma-separated company/regulator domains treated as Tier 1.
WEB_OFFICIAL_DOMAINS=
MAX_AGENT_ITERATIONS=10
MAX_LLM_CALLS_PER_REQUEST=5
MAX_TOOL_CALLS_PER_REQUEST=10
MAX_REPLANS_PER_REQUEST=3
MAX_WEB_SEARCH_CALLS_PER_REQUEST=4
MAX_WEB_SOURCES_PER_REQUEST=10
MAX_TOTAL_EXTERNAL_CONTENT=12000

# ---- Stock advisory deployment ----
# The model_scoring container stays alive and runs H120 after market close.
TZ=Asia/Ho_Chi_Minh
VNSTOCK_API_KEY=
WAVE_DAILY_SCORING_TIME=19:00
WAVE_DAILY_SCORING_RUN_ON_START=true
WAVE_DAILY_SCORING_MAX_ATTEMPTS=8
WAVE_DAILY_SCORING_RETRY_MINUTES=30
WAVE_H120_REQUESTS_PER_MINUTE=25
WAVE_HISTORY_SESSIONS=480
# Never mark an older trading session as today's successful daily score.
WAVE_H120_MAX_STALENESS_DAYS=0
WAVE_DAILY_KEEP_SUCCESS_RUNS=14
WAVE_DAILY_FAILED_RETENTION_DAYS=3

# Browser-visible feature flags (read when the web container starts/builds).
NEXT_PUBLIC_SHORT_TERM_ENABLED=true
NEXT_PUBLIC_LONG_TERM_ENABLED=true
NEXT_PUBLIC_V6_ENABLED=true

# ---- vnstock (bản free cho python_data) ----
# API key miễn phí tại https://vnstocks.com/account#api-key: nâng giới hạn
# từ 20 (khách) lên 60 request/phút. Để trống thì chạy ở chế độ khách.
# VNSTOCK_API_KEY=
# 1 = mỗi lần khởi động python_data tự nâng vnstock lên bản mới nhất (thế hệ 5).
# VNSTOCK_AUTO_UPGRADE=1
# Thứ tự nguồn dữ liệu, nguồn sau là dự phòng khi nguồn trước lỗi.
# VNSTOCK_QUOTE_SOURCES=KBS,VCI
# VNSTOCK_INDUSTRY_SOURCES=VCI,KBS
# VNSTOCK_NEWS_SOURCES=VCI,KBS
# VNSTOCK_FINANCE_SOURCES=KBS,VCI
