# ==========================
# DAILY SCORING / LSTM GENERATED ARTIFACTS
# ==========================

# Dated run directories contain snapshots, logs, predictions and temporary
# manifests. Release contracts under deploy/ remain intentionally trackable.
runs/

# Provider caches and locally materialized OHLCV snapshots.
data_vnstock/

# Training-generated universe/configuration and notebook replay outputs.
configs/price_forecast_v6_coverage.json
reports/price_forecast_lstm/

# Model binaries/scalers are large and must be promoted through artifact
# storage; the serving manifests and scripts remain version-controlled.
*.keras
*.h5
*.joblib
*.pkl


# ==========================
# FINSIGHT CHATBOT LOCAL ARTIFACTS
# ==========================

# Temporary Python environments/caches created during local validation.
.tmp-venv/
pytest-cache-files-*/

# Local FastAPI/Python service output.
python_data/server_stdout.log
python_data/server_stderr.log

# Generated OCR, normalization and retrieval artifacts. Source code and SQL
# migrations under financial_ocr_mvp remain trackable.
financial_ocr_mvp/output/

# Local vector/database storage and portable backups belong in artifact
# storage, not Git.
qdrant_storage/
qdrant_data/
postgres_data/
redis_data/
minio_data/
*.dump
*.backup
*.sql.gz
*.snapshot

